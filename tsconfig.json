{
  "compilerOptions": {
    "target": "ES2022",
    "module": "preserve",
    "moduleResolution": "bundler",
    "strict": true,
    "esModuleInterop": true,
    "types": ["node"],
    "paths": {
      "@pages/*": ["./pages/*"],
      "@fixtures/*": ["./fixtures/*"],
      "@config/*": ["./config/*"]
    }
  },
  "include": ["pages/**/*.ts", "fixtures/**/*.ts", "config/**/*.ts", "tests/**/*.ts", "playwright.config.ts"]
}